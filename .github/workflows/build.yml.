
name: Build UID Filter

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: windows-latest

    steps:
      - name: Checkout source
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Setup Android SDK
        uses: android-actions/setup-android@v4
        with:
          packages: ''

      - name: Install Android NDK
        shell: pwsh
        run: |
          sdkmanager --install "ndk;27.3.13750724"

      - name: Build UID Filter
        shell: pwsh
        run: |
          $sdk = $env:ANDROID_SDK_ROOT
          if (-not $sdk) {
            $sdk = $env:ANDROID_HOME
          }
          $env:ANDROID_NDK_HOME = Join-Path $sdk 'ndk\27.3.13750724'
          python tools/uid-seccomp-module/build.py --module-only

      - name: Upload compiled module
        uses: actions/upload-artifact@v4
        with:
          name: uid-filter-build
          path: |
            build/0.2.6/cq-uid-seccomp-0.2.6.zip
            build/0.2.6/cq-uid-seccomp-0.2.6.zip.sha256
          if-no-files-found: error
